PORT=3000
NODE_ENV=development

# Neon Postgres. Use the pooled URL for the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Optional direct Neon URL for manual maintenance.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-side admin login. The password is hashed into Neon on first startup.
ADMIN_EMAIL=admin@eckintosh.local
ADMIN_PASSWORD=

# Used to sign the httpOnly admin session cookie.
JWT_SECRET=
